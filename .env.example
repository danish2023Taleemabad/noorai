# Copy to .env and fill in. .env is git-ignored.

# --- WhatsApp Business Calling API (Meta Cloud API) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
WHATSAPP_GRAPH_VERSION=v21.0

# --- OpenAI Realtime ---
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REASONING_EFFORT=minimal
OPENAI_VAD_SILENCE_MS=5

# --- Taleemabad backend (context data) ---
TALEEMABAD_BASE_URL=https://schools.niete.pk
TALEEMABAD_ACCESS_TOKEN=

# --- Curriculum context (optional; grade/subject lesson-plan help) ---
# Loaded ONCE at boot into RAM (no per-call latency). Leave the SA empty to
# disable curriculum — Noor still works. GOOGLE_SERVICE_ACCOUNT_JSON is the
# read-only Google service-account JSON (one line) that can read the matrix sheet.
GOOGLE_SERVICE_ACCOUNT_JSON=
CURRICULUM_SHEET_ID=1nzrAZ0LUIRxKoGh3GsuES86P5w_E3RbYf2kZ9SAppTg
CURRICULUM_TAB=All Segments + SLOs

# --- TURN (optional; needed on hosts without UDP, e.g. Railway) ---
# Comma-separated. Use TURN over TCP/TLS on Railway, e.g.:
#   turns:turn.example.com:5349?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Set true to force ALL media through TURN (useful to verify the relay path).
TURN_FORCE_RELAY=false

# --- Rumi history (optional; caller's past chats with the Rumi WhatsApp bot) ---
# Read-only connection to Rumi's prod DB. A background job syncs each caller's
# history into Noor's own DB, so the live call path only reads Noor's local copy
# (zero added latency). Leave user/password empty to disable. Host/port/name
# default to the Supabase pooler.
RUMI_DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
RUMI_DB_PORT=6543
RUMI_DB_USER=
RUMI_DB_PASSWORD=
RUMI_DB_NAME=postgres
RUMI_SYNC_INTERVAL_MINUTES=360
RUMI_SUMMARY_CAP=150

# --- Database (optional; call logs + transcripts) ---
# Railway injects DATABASE_URL when you add a Postgres plugin. Leave empty to
# disable logging (calls still work). Set DATABASE_SSL=true only for a public
# (proxy) DB URL, not Railway's in-project private URL.
DATABASE_URL=
DATABASE_SSL=false

# --- Server ---
PORT=8080
PUBLIC_BASE_URL=
